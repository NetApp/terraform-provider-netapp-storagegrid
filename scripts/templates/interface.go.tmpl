func UpdateGoPrefix(errorHandler *utils.ErrorHandler, r *restclient.RestClient, id string, body GoPrefixResourceBodyDataModel) (*GoPrefixGetDataModel, error) {
	api := "api_url/" + id
	var bodyMap map[string]interface{}
	if err := decode(body, &bodyMap); err != nil {
