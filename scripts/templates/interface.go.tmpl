// DeleteGoPrefix to delete tag_prefix.  It is not an error if the tag_prefix is already gone.
func DeleteGoPrefix(errorHandler *utils.ErrorHandler, r *restclient.RestClient, id string) error {
	api := "api_url/" + id
	statusCode, _, err := r.CallDeleteMethod(api, nil, nil)
	if err != nil && !restclient.IsNotFound(err) {
		return errorHandler.MakeAndReportError("error deleting tag_prefix", fmt.Sprintf("error on DELETE %s: %s, statusCode %d", api, err, statusCode))
	}
	return nil
}

// decodeGoPrefixResponse reads the object returned by a POST or a PUT.
func decodeGoPrefixResponse(errorHandler *utils.ErrorHandler, method string, api string, statusCode int, response restclient.RestResponse) (*GoPrefixGetDataModel, error) {
	object, ok := response.Object()
	if !ok {
		return nil, errorHandler.MakeAndReportError(fmt.Sprintf("unexpected response from %s %s", method, api),
			fmt.Sprintf("expected an object, statusCode %d, response %#v", statusCode, response.Data))
	}
	var data GoPrefixGetDataModel
	if err := decode(object, &data); err != nil {
		return nil, errorHandler.MakeAndReportError(fmt.Sprintf("failed to decode response from %s %s", method, api),
			fmt.Sprintf("error: %s, statusCode %d, response %#v", err, statusCode, object))
	}
	tflog.Debug(errorHandler.Ctx, fmt.Sprintf("%s %s: %#v", method, api, data))
	return &data, nil
}
