// GoPrefixGetDataModel describes the GET data model using go types for mapping.
type GoPrefixGetDataModel struct {
	ID   string `mapstructure:"id"`
	Name string `mapstructure:"name"`
}

// GoPrefixResourceBodyDataModel describes the POST and PUT body using go types for mapping.
type GoPrefixResourceBodyDataModel struct {
	Name string `mapstructure:"name"`
}

// GoPrefixDataSourceFilterModel describes the filter of the data source that lists the tag_all_prefix.
// StorageGRID has no generic query filter: the filter is applied on the list returned by the API.
type GoPrefixDataSourceFilterModel struct {
	Name string `mapstructure:"name"`
}

// GetGoPrefixByID to get tag_prefix info.  It returns nil, with no error, if the tag_prefix does not exist.
func GetGoPrefixByID(errorHandler *utils.ErrorHandler, r *restclient.RestClient, id string) (*GoPrefixGetDataModel, error) {
	api := "api_url/" + id
	statusCode, response, err := r.GetNilOrObject(api, nil)
	if err != nil {
		return nil, errorHandler.MakeAndReportError("error reading tag_prefix info", fmt.Sprintf("error on GET %s: %s, statusCode %d", api, err, statusCode))
	}
	if response == nil {
		return nil, nil
	}

	var data GoPrefixGetDataModel
	if err := decode(response, &data); err != nil {
		return nil, errorHandler.MakeAndReportError(fmt.Sprintf("failed to decode response from GET %s", api),
			fmt.Sprintf("error: %s, statusCode %d, response %#v", err, statusCode, response))
	}
	tflog.Debug(errorHandler.Ctx, fmt.Sprintf("Read tag_prefix: %#v", data))
	return &data, nil
}

// GetGoPrefixByName to get tag_prefix info.  An error is reported unless exactly one tag_prefix has this name.
func GetGoPrefixByName(errorHandler *utils.ErrorHandler, r *restclient.RestClient, name string) (*GoPrefixGetDataModel, error) {
	found, err := GetAllGoPrefix(errorHandler, r, &GoPrefixDataSourceFilterModel{Name: name})
	if err != nil {
		return nil, err
	}
	switch len(found) {
	case 0:
		return nil, errorHandler.MakeAndReportError("tag_prefix not found", fmt.Sprintf("no tag_prefix with name %q", name))
	case 1:
		return &found[0], nil
	}
	return nil, errorHandler.MakeAndReportError("tag_prefix is not unique", fmt.Sprintf("%d tag_prefix have the name %q", len(found), name))
}

// GetAllGoPrefix to get tag_prefix info for all the tag_all_prefix matching a filter
func GetAllGoPrefix(errorHandler *utils.ErrorHandler, r *restclient.RestClient, filter *GoPrefixDataSourceFilterModel) ([]GoPrefixGetDataModel, error) {
	api := "api_url"
	// GetAllObjects follows the pagination of the APIs that have one (limit and marker), and works with the others.
	// Use GetZeroOrMoreObjects instead if the API has no id in its objects.
	statusCode, response, err := r.GetAllObjects(api, nil)
	if err != nil {
		return nil, errorHandler.MakeAndReportError("error reading tag_all_prefix info", fmt.Sprintf("error on GET %s: %s, statusCode %d", api, err, statusCode))
	}

	var data []GoPrefixGetDataModel
	for _, info := range response {
		var record GoPrefixGetDataModel
		if err := decode(info, &record); err != nil {
			return nil, errorHandler.MakeAndReportError(fmt.Sprintf("failed to decode response from GET %s", api),
				fmt.Sprintf("error: %s, statusCode %d, info %#v", err, statusCode, info))
		}
		if filter != nil && filter.Name != "" && record.Name != filter.Name {
			continue
		}
		data = append(data, record)
	}
	tflog.Debug(errorHandler.Ctx, fmt.Sprintf("Read tag_all_prefix: %#v", data))
	return data, nil
}

// CreateGoPrefix to create tag_prefix.  StorageGRID returns the new object, with its id.
func CreateGoPrefix(errorHandler *utils.ErrorHandler, r *restclient.RestClient, body GoPrefixResourceBodyDataModel) (*GoPrefixGetDataModel, error) {
	api := "api_url"
	var bodyMap map[string]interface{}
	if err := decode(body, &bodyMap); err != nil {
		return nil, errorHandler.MakeAndReportError("error encoding tag_prefix body", fmt.Sprintf("error on encoding %s body: %s, body: %#v", api, err, body))
	}
	statusCode, response, err := r.CallCreateMethod(api, nil, bodyMap)
	if err != nil {
		return nil, errorHandler.MakeAndReportError("error creating tag_prefix", fmt.Sprintf("error on POST %s: %s, statusCode %d", api, err, statusCode))
	}
	return decodeGoPrefixResponse(errorHandler, "POST", api, statusCode, response)
}

